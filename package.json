{
  "name": "safe-vault",
  "version": "4.0.0",
  "description": "密码保险箱 - 个人账号密码管理器",
  "author": "SafeVault Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 7331 --strictPort\" \"wait-on http://localhost:7331 && electron .\"",
    "dev:kill": "npx kill-port 7331 && npm run dev",
    "build": "npm run build:bridge && vite build && electron-builder",
    "electron": "electron .",
    "verify:vault-crypto": "node scripts/verify-vault-crypto.cjs",
    "verify:bridge": "node scripts/verify-bridge-server.cjs",
    "verify:extension": "node scripts/verify-extension.cjs",
    "verify:native-host": "node scripts/verify-native-host-manager.cjs",
    "verify:dotnet": "dotnet test native-bridge/SafeVault.Bridge.Tests/SafeVault.Bridge.Tests.csproj",
    "verify": "node scripts/verify-normalize-data.cjs && node scripts/verify-vault-crypto.cjs && node scripts/verify-vault-migration.cjs && node scripts/verify-vault-session.cjs && node scripts/verify-app-settings.cjs && node scripts/verify-credential-matcher.cjs && node scripts/verify-clipboard-manager.cjs && node scripts/verify-bridge-server.cjs && node scripts/verify-extension.cjs && node scripts/verify-native-host-manager.cjs && node scripts/verify-theme-wiring.cjs && node scripts/verify-window-state.cjs && node scripts/verify-security-boundaries.cjs && npm run verify:dotnet",
    "build:bridge": "dotnet publish native-bridge/SafeVault.Bridge.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o native-bridge/publish",
    "package:extension": "node scripts/package-browser-extension.cjs"
  },
  "dependencies": {
    "antd": "^6.3.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-quill-new": "^3.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.safevault.app",
    "productName": "密码保险箱",
    "icon": "src/images/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "src/images/icon.png",
        "to": "icon.png"
      },
      {
        "from": "native-bridge/publish",
        "to": "native-bridge",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "browser-extension",
        "to": "browser-extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "src/images/icon.png",
      "sign": null,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "guid": "com.safevault.app",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "2052",
      "multiLanguageInstaller": false,
      "displayLanguageSelector": false
    }
  }
}
